{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edytor",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/edytor/server.js"],
      "port": 3000
    },
    {
      "name": "dist",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "dist"],
      "port": 8080
    },
    {
      "name": "dist-test",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8081", "--directory", "dist-test"],
      "port": 8081
    }
  ]
}
